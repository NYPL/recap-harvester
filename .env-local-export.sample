# Creds for connecting to the SCSB S3 bucket containing updates
s3Bucket=[aws s3 bucket name for scsb]
s3AccessKey=[aws access key for scsb bucket]
s3SecretKey=[aws secret key for scsb bucket]
s3BaseLocation=data-exports/NYPL

# Prefix for incremental updates in S3 bucket:
accessionDirectory=SCSBXml/Incremental/
accessionProcessedDirectory=SCSBXml/Incremental.processed/

# Prefix for deaccession jsons in S3 bucket:
deaccessionDirectory=Json/
deaccessionProcessedDirectory=Json.processed/

# Creds for connecting to the SchemaService:
NyplOAuthKey=[platform api client id]
NyplOAuthSecret=[platform api client secret]
NyplOAuthUrl=https://isso.nypl.org/oauth/token
platformAPIBasePath=https://platform.nypl.org/api/v0.1

# Schema paths in SchemaService:
bibSchemaPath=/current-schemas/BibPostRequest
itemSchemaPath=/current-schemas/ItemPostRequest

# Which Kinesis streams to send updates and deletions:
kinesisBibStream=BibPostRequest-qa
kinesisItemStream=ItemPostRequest-qa

# Creds to write to Kinesis streams:
AWS_ACCESS_KEY_ID=[aws key]
AWS_SECRET_ACCESS_KEY=[aws secret]
AWS_REGION=us-east-2

# Keep the following as true to run the app in "Nightly Updates" mode (as opposed to "Bulk" mode)
onlyDoUpdates=true

# Localize EN US:
LC_ALL=en_US.UTF-8
